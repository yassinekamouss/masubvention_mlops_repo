# ==============================================================================
# Tamkeen MLOps — Environment Variables Configuration
# ==============================================================================

# LLM Providers (Optionnel : Fallback expert déterministe si aucune clé fournie)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend Express Webhook Integration
EXPRESS_WEBHOOK_URL=http://localhost:5000/api/internal/webhook/dossier-completed
INTERNAL_WEBHOOK_SECRET=your_internal_webhook_secret_here
WEBHOOK_TIMEOUT_SECONDS=15.0

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
ENVIRONMENT=development
LOG_LEVEL=info

